# ---- Server (copy this file to server/.env) ----
PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# Optional
JWT_EXPIRES_IN=7d
# Comma separated origins allowed to call the API (only needed when the client is served from another origin)
CLIENT_ORIGIN=http://localhost:5173
# Comma separated emails that become admins when they register
ADMIN_EMAILS=

# ---- Client (optional, create client/.env only if you need these) ----
# In development the Vite dev server proxies /api and /socket.io to http://localhost:5000.
# VITE_PROXY_TARGET=http://localhost:5000
# For a deployed build where the API lives on another origin:
# VITE_API_URL=https://your-api.example.com/api
# VITE_SOCKET_URL=https://your-api.example.com
